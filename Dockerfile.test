# Runs the Playwright E2E suite the way CI does.
#
# Headless, so nothing here deals with a display: the suite loads the extension
# through `channel: "chromium"`, which runs the full browser in Chrome's newer
# headless mode. See the note in playwright.config.ts. The xvfb, x11vnc and fluxbox
# this file used to apt-get went with the headed run - and were never needed even
# then: the base image already carries Xvfb, and nothing ever started the other two
# or published a port to reach them on.
#
# Keep this tag in lockstep with @playwright/test in package.json. The image
# ships the browser set of its own version; when the two drift, the install
# below quietly downloads a second set on every build.
FROM mcr.microsoft.com/playwright:v1.62.0-noble

WORKDIR /app

COPY package*.json ./
RUN npm ci

# Browsers and their system dependencies are already in the image, at the
# PLAYWRIGHT_BROWSERS_PATH it sets itself. This stays as the safety net for the
# build where the tag above has drifted from the lockfile - it is a no-op when
# they agree, which is why it does not need --with-deps.
RUN npx playwright install chromium

COPY . .

# test:e2e builds the extension first; dist/ is in .dockerignore, so what gets
# tested is always built from the source in this image.
CMD ["npm", "run", "test:e2e"]
